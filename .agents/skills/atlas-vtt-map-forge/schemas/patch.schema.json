{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JSON Patch supported subset: add, remove, replace, test",
  "type": "array",
  "minItems": 1,
  "items": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "op": {
            "enum": [
              "add",
              "replace",
              "test"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "value": {}
        },
        "required": [
          "op",
          "path",
          "value"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "const": "remove"
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "required": [
          "op",
          "path"
        ],
        "additionalProperties": false
      }
    ]
  }
}
